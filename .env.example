# Create the database first, then add its credentials here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tee_components
DB_USER=root
DB_PASSWORD=

# Used by: php scripts/create-admin.php
ADMIN_NAME=Tee Components Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-running

# Resend delivery. For testing, Resend allows its onboarding sender; verify your domain before production.
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Tee Components
# Optional: redirects every outgoing email to this address while testing.
RESEND_TEST_RECIPIENT=your-test-inbox@example.com

# SMTP fallback. Used only when RESEND_API_KEY is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=replace-with-an-app-password

# Website enquiry delivery. Use an address on your verified domain in production.
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Tee Components
ENQUIRY_RECIPIENT=admin@example.com
APP_URL=http://localhost:8000
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key
